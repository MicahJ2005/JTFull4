<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="title" type="String" label="Title" default="Card Title"/>
            <property name="imageUrl" type="String" label="Custom Image URL (Optional)" description="URL de la imagen/icono (ej: /resource/MyIcon)"/>
            <property name="iconName" type="String" label="Fallback Icon Name" default="standard:account"/>
            <property name="variant" type="String" label="Type (button or text)" default="button"/>
            <property name="buttonLabel" type="String" label="Button Label"/>
            <property name="subtitle" type="String" label="Subtitle Text"/>
            <property name="accentColor" type="String" label="Accent Color (Hex)" default="#005587"/>
            <property name="destinationUrl" type="String" label="Link URL" description="URL interna relativa (ej: /task-tracker) o externa (https://...)"/>
            <property name="pageApiName" type="String" label="Site Page API Name (recommended)" description="Si lo seteas, navega a esta pagina del site por su API Name (ignora Link URL)."/>
            <property name="openInNewTab" type="Boolean" label="Open Link in New Tab" default="false"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>