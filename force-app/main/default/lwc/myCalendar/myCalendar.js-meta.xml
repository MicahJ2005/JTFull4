<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>My Calendar</masterLabel>
    <description>Client portal calendar: grouped appointments + month view with dots. Shows the logged-in client's Events.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="contactPageName" type="String" label="Contact My Team Page API Name" default="Contact_My_Team__c"/>
            <property name="scheduleText" type="String" label="'Need to Schedule' Text"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>