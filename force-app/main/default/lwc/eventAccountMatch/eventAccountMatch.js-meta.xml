<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Event Account Matcher</masterLabel>
    <description>Displays potential Person Account matches retrieved by Agentforce when the Event's Related To field is unpopulated.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <!-- Restrict component placement specifically to Event Record Pages -->
            <objects>
                <object>Event</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>